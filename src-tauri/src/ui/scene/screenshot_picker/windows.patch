diff --git a/src-tauri/src/ui/scene/screenshot_picker/windows.rs b/src-tauri/src/ui/scene/screenshot_picker/windows.rs
new file mode 100644
index 0000000..7c9ef1e
--- /dev/null
+++ b/src-tauri/src/ui/scene/screenshot_picker/windows.rs
@@ -0,0 +1,103 @@
+//! Detects the Windows Snipping Tool capture overlay from foreground changes.
+//! The foreground WinEvent hook is owned by `ufa::windows`; this module only
+//! keeps the small piece of state needed by scene reconciliation.
+use std::ffi::OsString;
+use std::io;
+use std::os::windows::ffi::OsStringExt;
+use std::path::Path;
+use std::sync::atomic::{AtomicBool, Ordering};
+
+use windows::Win32::Foundation::{CloseHandle, HWND};
+use windows::Win32::System::ProcessStatus::GetModuleFileNameExW;
+use windows::Win32::System::Threading::{OpenProcess, PROCESS_QUERY_LIMITED_INFORMATION};
+use windows::Win32::UI::WindowsAndMessaging::{
+    GetClassNameW, GetWindowTextW, GetWindowThreadProcessId,
+};
+
+pub(super) const ENABLED: bool = true;
+pub(super) const SAMPLE_INTERVAL: std::time::Duration = std::time::Duration::ZERO;
+
+static ACTIVE: AtomicBool = AtomicBool::new(false);
+
+pub(super) fn is_active() -> io::Result<bool> {
+    Ok(ACTIVE.load(Ordering::Acquire))
+}
+
+pub(super) fn observe_foreground(hwnd: HWND) {
+    ACTIVE.store(is_snipping_tool_overlay(hwnd), Ordering::Release);
+}
+
+fn is_snipping_tool_overlay(hwnd: HWND) -> bool {
+    let class = window_class(hwnd);
+    let title = window_title(hwnd);
+    if !matches_window_identifiers(&class, &title) {
+        return false;
+    }
+
+    process_name(hwnd).is_some_and(|name| name.eq_ignore_ascii_case("SnippingTool.exe"))
+}
+
+fn matches_window_identifiers(class: &str, title: &str) -> bool {
+    class == "XamlWindow" && title == "Snipping Tool Overlay"
+}
+
+fn window_class(hwnd: HWND) -> String {
+    let mut buffer = [0u16; 256];
+    // SAFETY: `buffer` is writable and `hwnd` comes from the WinEvent callback.
+    let length = unsafe { GetClassNameW(hwnd, &mut buffer) };
+    String::from_utf16_lossy(&buffer[..length.max(0) as usize])
+}
+
+fn window_title(hwnd: HWND) -> String {
+    let mut buffer = [0u16; 256];
+    // SAFETY: `buffer` is writable and `hwnd` comes from the WinEvent callback.
+    let length = unsafe { GetWindowTextW(hwnd, &mut buffer) };
+    String::from_utf16_lossy(&buffer[..length.max(0) as usize])
+}
+
+fn process_name(hwnd: HWND) -> Option<String> {
+    let mut pid = 0;
+    // SAFETY: the optional output points to a live local variable.
+    unsafe { GetWindowThreadProcessId(hwnd, Some(&mut pid)) };
+    if pid == 0 {
+        return None;
+    }
+
+    // SAFETY: the PID was supplied by Windows for the foreground HWND.
+    let process = unsafe { OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, false, pid) }.ok()?;
+    if process.is_invalid() {
+        return None;
+    }
+
+    let mut buffer = [0u16; 1024];
+    // SAFETY: `process` is valid and `buffer` is writable.
+    let length = unsafe { GetModuleFileNameExW(process, None, &mut buffer) };
+    // SAFETY: this function owns the process handle returned by OpenProcess.
+    let _ = unsafe { CloseHandle(process) };
+    if length == 0 {
+        return None;
+    }
+
+    let path = OsString::from_wide(&buffer[..length as usize]);
+    Path::new(&path)
+        .file_name()
+        .map(|name| name.to_string_lossy().into_owned())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn distinguishes_capture_overlay_from_main_snipping_tool_window() {
+        assert!(matches_window_identifiers(
+            "XamlWindow",
+            "Snipping Tool Overlay"
+        ));
+        assert!(!matches_window_identifiers("XamlWindow", "Snipping Tool"));
+        assert!(!matches_window_identifiers(
+            "Tauri Window",
+            "Snipping Tool Overlay"
+        ));
+    }
+}
