{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "friendolls",
  "version": "0.1.0",
  "identifier": "com.adamcv.friendolls",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUzNTFBOTEwMDZBNTExOEQKUldTTkVhVUdFS2xSNHgyK0NiYmZXTy82RlhIYzVxNzNvdHZ5eitiSkozSzU0bm13R0t3QUtnd0oK",
      "endpoints": [
        "https://github.com/wind-explorer/friendolls/releases/latest/download/latest.json"
      ]
    }
  }
}
